diff --git a/docker-compose.yml b/docker-compose.yml
index 96ba4c6..1f960b3 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -97,35 +97,57 @@ services:
         condition: service_healthy
     networks:
       - verirag-network
+
   prometheus:
     image: prom/prometheus:latest
     volumes:
-      - ./prometheus.yml:/etc/prometheus/prometheus.yml
+      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
     ports: ["9090:9090"]
+    depends_on:
+      - fastapi
+    networks:
+      - verirag-network
 
   grafana:
     image: grafana/grafana:latest
     ports: ["3000:3000"]
     environment:
-      - GF_SECURITY_ADMIN_PASSWORD=admin
+      - GF_SECURITY_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD:-admin}
     volumes:
       - grafana-data:/var/lib/grafana
+      - ./grafana/provisioning:/etc/grafana/provisioning:ro
+      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
+    depends_on:
+      - prometheus
+    networks:
+      - verirag-network
 
   redis-exporter:
     image: oliver006/redis_exporter
     environment:
-      - REDIS_ADDR=redis://redis:6379
+      - REDIS_ADDR=redis://redis-primary:6379
     ports: ["9121:9121"]
+    depends_on:
+      redis-primary:
+        condition: service_healthy
+    networks:
+      - verirag-network
 
+  # Opt-in: only for scraping the real (Neon) database. Needs a read-only
+  # monitoring role; put its DSN in .env as POSTGRES_EXPORTER_DSN, e.g.
+  # postgresql://USER:PW@HOST/DB?sslmode=require
   postgres-exporter:
     image: quay.io/prometheuscommunity/postgres-exporter
+    profiles: ["postgres-exporter"]
     environment:
-      - DATA_SOURCE_NAME=postgresql://user:pass@postgres:5432/auditflow?sslmode=disable
+      - DATA_SOURCE_NAME=${POSTGRES_EXPORTER_DSN:-}
     ports: ["9187:9187"]
+    networks:
+      - verirag-network
 
 volumes:
   grafana-data:
 
 networks:
   verirag-network:
-    driver: bridge
\ No newline at end of file
+    driver: bridge
