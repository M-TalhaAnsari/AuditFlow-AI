      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 18,
      "type": "stat",
      "title": "Reload lag (versions behind)",
      "description": "0 = in sync. Brief 1 is normal during a reload; persistent non-zero means reloads are failing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "auditflow_index_version_current - auditflow_index_version_loaded",
          "legendFormat": "",
          "refId": "A",
          "instant": true
