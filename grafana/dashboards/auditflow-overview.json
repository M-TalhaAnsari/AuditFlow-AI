    {
      "id": 9,
      "type": "timeseries",
      "title": "Latency percentiles (all routes)",
      "description": "From http_request_duration_highr_seconds (accurate to 60 s). The per-route histogram only has buckets up to 1 s, which would flatten /ask, so it is not used for percentiles.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
