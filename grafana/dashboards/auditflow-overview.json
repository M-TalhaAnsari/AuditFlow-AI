    {
      "id": 17,
      "type": "timeseries",
      "title": "index:version, current vs loaded",
      "description": "current = latest counter in Redis. loaded = version this worker finished reloading caches for. They should overlap; a gap means this worker is serving a stale index.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "auditflow_index_version_current",
          "legendFormat": "current (Redis)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "auditflow_index_version_loaded",
          "legendFormat": "loaded (this worker)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
