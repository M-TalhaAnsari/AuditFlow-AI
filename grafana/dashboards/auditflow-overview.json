          },
          "expr": "increase(auditflow_cache_reload_total[$__rate_interval])",
          "legendFormat": "successful reloads",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(auditflow_cache_reload_failures_total[$__rate_interval])",
