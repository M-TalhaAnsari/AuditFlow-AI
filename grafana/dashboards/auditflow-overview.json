    {
      "id": 21,
      "type": "timeseries",
      "title": "Connections in use vs max",
      "description": "psycopg2 SimpleConnectionPool raises immediately when exhausted rather than queueing, so in use reaching max means failed requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "auditflow_pg_pool_connections_in_use",
          "legendFormat": "in use",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
